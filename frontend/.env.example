# ==============================================================================
# Invest IQ Frontend - Environment Configuration
# ==============================================================================

# Application Branding
NEXT_PUBLIC_APP_NAME="Invest IQ"

# Development Gateway (Only needed when proxying with local Flask backend)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# ==============================================================================
# Supabase PostgreSQL Datastore (Required for Production / Vercel Serverless)
# ==============================================================================
# CRITICAL SECURITY NOTE:
# 1. These are SERVER-ONLY secrets used exclusively by Next.js Serverless Route Handlers.
# 2. DO NOT prefix these with NEXT_PUBLIC_!
# 3. NEVER reference these variables from any client component ("use client" file).
#
# Where to obtain from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys
# - SUPABASE_URL: Found under "Project URL" (e.g. https://xyzcompany.supabase.co)
# - SUPABASE_SERVICE_ROLE_KEY: Found under "Project API Keys" -> "service_role" (secret)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ==============================================================================
# Agent Layer Security (Server-to-Server shared secret between Next.js and Flask)
# CRITICAL: MUST NOT HAVE NEXT_PUBLIC_ PREFIX (Server-only secret!)
# ==============================================================================
AGENT_SERVICE_SECRET=investiq_agent_service_secret_production_key_change_me
