# .env.example - Invest IQ Environment Configuration
# Copy to .env for local testing or enter in Render / Vercel dashboard

# Flask session security (Render generates this automatically)
SECRET_KEY=investiq_super_secret_production_key_change_me

# Optional: Groq AI API Key for Llama 3.1 Plain-English Technical Explanations
# Free tier key available at https://console.groq.com
# If omitted, Invest IQ seamlessly uses its built-in rule-based deterministic explainer
GROQ_API_KEY=

# Server port (Render automatically sets $PORT to 10000)
PORT=5000

# Environment mode
FLASK_ENV=production

# Agent Layer Security (Server-to-Server shared secret between Next.js and Flask)
AGENT_SERVICE_SECRET=investiq_agent_service_secret_production_key_change_me

# Supabase PostgreSQL Datastore Access for Agentic Layer
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
